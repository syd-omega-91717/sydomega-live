{
  "monitoring": {
    "version": "1.0",
    "enabled": true,
    "updateInterval": 5000,
    "alertThresholds": {
      "lcp": {
        "good": 2500,
        "warning": 4000,
        "critical": 5000,
        "unit": "ms"
      },
      "fid": {
        "good": 100,
        "warning": 300,
        "critical": 500,
        "unit": "ms"
      },
      "cls": {
        "good": 0.1,
        "warning": 0.25,
        "critical": 0.5,
        "unit": "score"
      },
      "ttfb": {
        "good": 600,
        "warning": 1000,
        "critical": 1500,
        "unit": "ms"
      },
      "pageLoadTime": {
        "good": 3000,
        "warning": 5000,
        "critical": 7000,
        "unit": "ms"
      },
      "apiLatency": {
        "good": 200,
        "warning": 500,
        "critical": 1000,
        "unit": "ms"
      },
      "errorRate": {
        "good": 0.01,
        "warning": 0.05,
        "critical": 0.1,
        "unit": "fraction"
      },
      "cacheHitRate": {
        "good": 0.7,
        "warning": 0.5,
        "critical": 0.3,
        "unit": "fraction"
      }
    },
    "alerts": {
      "enabled": false,
      "channels": [],
      "status": "NOT_WIRED"
    },
    "sampling": {
      "enabled": false,
      "rates": {
        "slow_page_load": 1,
        "error": 1,
        "normal_page_load": 0.1,
        "api_call": 0.05
      },
      "status": "NOT_RUNTIME_WIRED"
    },
    "retention": {
      "localStorage": {
        "maxRecords": 1000,
        "ttlDays": 7
      },
      "server": {
        "maxRecords": 100000,
        "ttlDays": 30
      },
      "status": "NOT_RUNTIME_WIRED"
    },
    "dashboards": {
      "enabled": true,
      "paths": [
        "/monitoring-dashboard.html"
      ],
      "refreshInterval": 5000,
      "status": "CURRENT_PAGE_ONLY; NOT_A_HISTORICAL_SRE_DASHBOARD"
    },
    "reports": {
      "enabled": false,
      "status": "NOT_CONFIGURED; NO_RECIPIENTS_STORED_IN_PUBLIC_CONFIGURATION"
    },
    "operationalStatus": "PARTIAL_WEB_VITALS_TELEMETRY_ONLY; THIS_CONFIGURATION_IS_NOT_LOADED_BY_THE_BROWSER_RUNTIME"
  },
  "rateLimit": {
    "enabled": false,
    "status": "NOT_DEPLOYED",
    "policies": [],
    "proposedPolicies": [
      {
        "name": "ip_based",
        "type": "sliding_window",
        "key": "ip",
        "limit": 1000,
        "window": 60,
        "unit": "seconds",
        "action": "reject"
      },
      {
        "name": "member_based",
        "type": "sliding_window",
        "key": "member_id",
        "limit": 100,
        "window": 60,
        "unit": "seconds",
        "action": "reject"
      },
      {
        "name": "burst_protection",
        "type": "concurrent",
        "key": "member_id",
        "limit": 20,
        "window": 5,
        "unit": "seconds",
        "action": "queue"
      }
    ]
  },
  "security": {
    "rls_audit": {
      "enabled": true,
      "schedule": "every_commit"
    },
    "schema_validation": {
      "enabled": true,
      "schedule": "every_commit"
    },
    "xss_prevention": {
      "enabled": true,
      "sanitization": "textContent_roundtrip"
    },
    "rate_limit_validation": {
      "enabled": true,
      "schedule": "hourly"
    }
  }
}
