{
  "$schema": "./page-character-manifest.schema.json",
  "version": 1,
  "default": {
    "visual": "sovereign",
    "motion": "subtle",
    "depth": "glass",
    "density": "clear",
    "interaction": "direct",
    "emblem": "omega"
  },
  "archetypes": {
    "command": {
      "visual": "command",
      "motion": "cinematic",
      "depth": "orbital",
      "density": "clear",
      "interaction": "direct",
      "emblem": "command",
      "worldRole": "Navigator",
      "worldVerb": "DIRECT",
      "primaryActions": [
        "decide",
        "accept mission",
        "review standing"
      ],
      "successOutcome": "mission accepted"
    },
    "identity": {
      "visual": "identity",
      "motion": "ceremonial",
      "depth": "glass",
      "density": "clear",
      "interaction": "direct",
      "emblem": "identity",
      "worldRole": "Avatar",
      "worldVerb": "BECOME",
      "primaryActions": [
        "customize",
        "equip",
        "present"
      ],
      "successOutcome": "identity advanced"
    },
    "intelligence": {
