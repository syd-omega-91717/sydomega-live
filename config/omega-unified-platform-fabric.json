{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Ω SYD OMEGA 91717 Unified Platform Fabric",
  "version": 2,
  "principle": "ONE_PLATFORM_MANY_PROJECTIONS",
  "truth_states": [
    "LIVE",
    "IMPLEMENTED",
    "RUNTIME-VERIFIED",
    "PRODUCTION-VERIFIED",
    "PARTIAL",
    "CALCULATED",
    "SIMULATED",
    "USER-CREATED",
    "EMPTY",
    "UNAVAILABLE",
    "UNVERIFIED",
    "BLOCKED",
    "LORE",
    "FUTURE",
    "REJECTED",
    "REPLACED"
  ],
  "page_contract_required": [
    "page_id",
    "path",
    "workspace",
    "domain",
    "primary_role",
    "purpose",
    "data_sources",
    "capabilities",
    "tasks",
    "authorization",
    "truth_states",
    "asset_requirements",
    "events",
    "failure_paths",
    "accessibility",
    "responsive",
    "traceability",
    "evidence"
  ],
  "content_types": [
    "image",
    "video",
    "audio",
    "movie",
    "series",
    "episode",
    "game",
    "game_asset",
    "character",
    "document",
    "pdf",
    "poster",
    "thumbnail",
    "dataset",
    "research",
    "downloadable_file"
  ],
  "content_contract_required": [
    "content_id",
    "content_type",
    "title",
    "source",
    "provenance",
    "truth_state",
    "rights",
    "lifecycle",
    "assets",
    "relationships",
    "access_policy",
    "evidence"
  ],
  "task_states": [
    "OPEN",
    "READY",
    "AUTHORIZED",
    "RUNNING",
    "VERIFYING",
    "COMPLETED",
    "FAILED",
    "BLOCKED",
    "CANCELLED"
  ],
  "task_types": [
    "CREATE",
    "READ",
    "UPDATE",
    "DELETE",
    "UPLOAD",
    "DOWNLOAD",
    "PUBLISH",
    "UNPUBLISH",
    "VERIFY",
    "APPROVE",
    "REJECT",
    "GENERATE",
    "IMPORT",
    "EXPORT",
    "SEARCH",
    "ANALYZE",
    "SIMULATE",
    "BOOK",
    "PAY",
    "RECONCILE",
    "AUDIT",
    "RECOVER"
  ],
  "release_rule": "A page, capability, content object or task is not production-complete merely because it renders or exists in source. Provider evidence remains authoritative.",
  "operating_model": "ONE_GOVERNED_CORE_MANY_DOMAIN_PROJECTIONS",
  "canonical_authorities": {
    "page_contracts": "config/omega-page-contracts.json",
    "content_registry": "config/content-registry.json",
    "capability_registry": "Supabase public.capability_registry plus existing repository capability contracts",
    "task_fabric": "existing governed task/capability contracts and task completion records",
    "requirement_traceability": "config/omega-requirement-control-plane.json and config/omega-source-traceability-v2.json",
    "release_evidence": "config/omega-production-10-10-evidence-gate.json",
    "event_evidence": "existing Supabase event/evidence/lineage contracts",
    "design_and_navigation": "existing shared design primitives, nav.js, and experience contracts"
  },
  "core_invariants": [
    "ONE_IDENTITY_AND_POLICY_BOUNDARY",
    "ONE_CANONICAL_TRUTH_VOCABULARY",
    "ONE_GOVERNED_TASK_LIFECYCLE",
    "ONE_VERSIONED_EVENT_AND_EVIDENCE_MODEL",
    "ONE_RELEASE_EVIDENCE_GATE",
    "DOMAIN_OWNERSHIP_MUST_BE_EXPLICIT",
    "DOMAIN_MODULES_MUST_NOT_CREATE_PARALLEL_CORE_REGISTRIES",
    "CLIENT_RENDERING_IS_NOT_AUTHORIZATION",
    "SOURCE_IMPLEMENTATION_IS_NOT_PROVIDER_OR_PRODUCTION_EVIDENCE",
    "UNKNOWN_ACTIONS_GENERATE_REMEDIATION_NOT_SYNTHETIC_MAPPINGS"
  ],
  "domain_module_contract_required": [
    "domain_id",
    "customer_job",
    "accountable_owner",
    "canonical_capabilities",
    "authoritative_data_sources",
    "authorization_boundary",
    "truth_states",
    "dependencies",
    "failure_paths",
    "telemetry",
    "acceptance_tests",
    "cost_and_operational_owner",
    "release_evidence",
    "rollback_or_retirement"
  ],
  "task_contract_required": [
    "task_id",
    "user_problem",
    "expected_outcome",
    "source_traceability",
    "page_and_domain_ids",
    "capability_id",
    "authoritative_data",
    "authorization_cases",
    "truth_state",
    "acceptance_criteria",
    "failure_and_retry_behavior",
    "tests",
    "owner",
    "cost_and_risk",
    "deployment_evidence",
    "rollback",
    "residual_risks"
  ],
  "task_done_rule": "DONE_REQUIRES_CONTRACT_TESTS_AUTHORIZATION_NEGATIVE_CASES_FAILURE_HANDLING_TRACEABILITY_AND_REQUIRED_RUNTIME_OR_PRODUCTION_EVIDENCE",
  "unification_rule": "Unify policy, identity, task lifecycle, data/content metadata, events, evidence, navigation primitives and release controls; preserve specialist domain pages and authoritative domain data boundaries.",
  "anti_patterns": [
    "parallel capability or page registries without explicit migration",
    "generic mappings that hide unknown actions",
    "client-generated financial, achievement, KYC, owner, or deployment truth",
    "monolith rewrite or microservice split without measured need and approved decision record",
    "feature activation based only on UI, prompt, SQL file, or successful static test",
    "vanity KPIs without source, definition, freshness, and production evidence"
  ]
}
