      "motion": "reactive",
      "depth": "holographic",
      "density": "data",
      "interaction": "explore",
      "emblem": "intelligence",
      "worldRole": "Seeker",
      "worldVerb": "DISCOVER",
      "primaryActions": [
        "investigate",
        "consult",
        "compare",
        "trace"
      ],
      "successOutcome": "insight recorded"
    },
    "knowledge": {
      "visual": "knowledge",
      "motion": "calm",
      "depth": "glass",
      "density": "readable",
      "interaction": "learn",
      "emblem": "knowledge",
      "worldRole": "Scholar",
      "worldVerb": "MASTER",
      "primaryActions": [
        "learn",
        "practice",
        "verify",
        "certify"
      ],
