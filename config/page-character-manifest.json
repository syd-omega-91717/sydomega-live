    "system": {
      "visual": "control",
      "motion": "precise",
      "depth": "holographic",
      "density": "technical",
      "interaction": "operate",
      "emblem": "system",
      "worldRole": "Guardian",
      "worldVerb": "PROTECT",
      "primaryActions": [
        "verify",
        "monitor",
        "recover",
        "operate"
      ],
      "successOutcome": "system state verified"
    }
  },
  "rules": [
    {
      "match": "command|dashboard|home",
      "archetype": "command"
    },
    {
      "match": "identity|profile|passport|character|account|membership",
      "archetype": "identity"
    },
    {
      "match": "intelligence|research|prediction|analytics|graph|search|oracle|agents|ai",
      "archetype": "intelligence"
    },
    {
      "match": "academy|knowledge|library|codex|exam|flashcard|grades|heritage|tutor",
      "archetype": "knowledge"
    },
    {
      "match": "gaming|game|arena|trophy|leaderboard",
      "archetype": "gaming"
    },
    {
      "match": "media|cinema|film|series|trailers|music|video",
      "archetype": "media"
    },
    {
      "match": "marketplace|commerce|merchant|store|shop|services",
      "archetype": "commerce"
    },
    {
      "match": "forge|creator|creation|publishing|contribution|lab|project",
      "archetype": "creation"
    },
    {
      "match": "social|family|contacts|feed|community|factions",
      "archetype": "community"
    },
    {
      "match": "governance|govern|compliance|approvals|charter|covenant|terms",
      "archetype": "governance"
    },
    {
      "match": "vault|treasury|wallet|income|payments|payment|investment|portfolio|ledger|budget|expenses",
      "archetype": "finance"
    },
    {
      "match": "settings|maintenance|system|admin|operator|enterprise|security|kyc",
      "archetype": "system"
    }
  ],
  "worldContract": {
    "version": 1,
    "purpose": "Every page is a place with a player role, a primary verb, concrete actions, and an observable outcome.",
    "loop": [
      "ENTER",
      "UNDERSTAND",
      "ACT",
      "RECEIVE FEEDBACK",
      "PROGRESS",
      "RETURN"
    ],
    "sourceOfTruth": "archetype + existing page implementation + existing data source; this manifest does not invent backend state.",
    "monetizationRule": "Paid features may expand expression, access, content, or convenience; earned status remains earned.",
    "cityBridge": "config/omega-world-manifest.json"
  }
}
