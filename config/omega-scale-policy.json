{
  "$schema":"https://sydomega.com/schemas/omega-scale-policy.v1.json",
  "schemaVersion":"1.0.0",
  "target":"billion-platform",
  "principles":{
    "authorization":"server-authoritative",
    "reads":"bounded-and-cacheable",
    "writes":"idempotent-and-audited",
    "failure":"fail-closed",
    "truth":"evidence-backed"
  },
  "clientBudgets":{
    "maxConcurrentDataReads":6,
    "defaultTimeoutMs":10000,
    "maxTimeoutMs":30000,
    "defaultPageSize":25,
    "maxPageSize":100,
    "maxCacheEntries":128,
    "cacheTtlMs":15000,
    "retryableAttempts":2
  },
  "apiBudgets":{
    "maxPayloadBytes":1048576,
    "maxBatchItems":100,
    "requirePaginationForCollections":true,
    "requireIdempotencyForWrites":true
  },
  "slo":{
    "interactiveReadP95Ms":800,
    "interactiveWriteP95Ms":1500,
    "availabilityTarget":0.999,
    "errorBudgetWindowDays":28
  },
  "partitioningCandidates":[
    "analytics_events","telemetry_events","omega_platform_events","activity_logs","audit_logs","client_errors"
  ],
  "hotPathCandidates":[
    "profiles","omega_member_mission_state","omega_member_quest_state","notifications","activity_feed","omega_platform_events"
  ],
  "doNotAutoDeleteIndexes":true,
  "indexRemovalRequiresEvidenceDays":28,
  "providerStateMustBeVerified":true
}
