{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": ["github-actions"],
  "dependencyDashboard": true,
  "labels": ["dependencies", "supply-chain"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rangeStrategy": "pin",
  "schedule": ["before 4am on monday"]
}
