  "productizationRules": {
    "fictional_physical_claims": "SIMULATION_ONLY until an independently deployable physical integration, operator, safety case and evidence exists.",
    "financial_actions": "Require server-authoritative authorization, idempotency, immutable ledger/reconciliation and provider evidence.",
    "health_features": "Require explicit consent, data minimization, clinical safety boundaries and qualified external providers; no autonomous diagnosis or treatment.",
    "surveillance_features": "No covert monitoring or biometric tracking; use explicit consent and auditable security telemetry.",
    "competitive_intelligence": "Use public/licensed data and defensive benchmarking; no intrusion, credential abuse or proprietary cloning.",
    "autonomous_agents": "Deny by default; explicit tools, scopes, budgets, rate limits, approvals and audit evidence.",
    "blockchain": "Treat ownership/minting as external-chain state only after signed transaction confirmation; no client-authoritative ownership.",
    "oracle_features": "Clearly label interpretive/divination content and never present it as verified prediction."
  },
  "acceptance": {
    "minimum": [
      "repo_artifact",
