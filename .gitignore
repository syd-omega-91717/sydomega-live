# Build artifact of scripts/build-content-registry.py. It was never committed;
# page-estate-inventory.yml generated it in CI and discarded it. The contract
# suite now builds it twice locally to check determinism, so ignore it rather
# than leave an untracked file in every working tree.
config/page-estate.generated.json

# Generated Vercel deployment artifact (scripts/vercel-build.sh emits it;
# vercel.json publishes it). Never committed -- it is a copy of the web surface.
public/
