{
  "realtimeAnalytics": {
    "version": "1.0",
    "enabled": true,
    "provider": "kafka_flink",
    "architecture": "event_streaming_lambda"
  },
  "kafkaTopics": {
    "member_events": {
      "partitions": 10,
      "replication_factor": 3,
      "retention_days": 7,
      "compression": "snappy",
      "consumers": [
        "analytics_engine",
        "personalization_service",
        "campaign_orchestrator",
        "anomaly_detector"
      ],
      "schema": {
        "event_id": "uuid",
        "member_id": "uuid",
        "event_type": "string",
        "timestamp": "timestamp_with_timezone",
        "properties": "json",
        "source": "string"
      }
    },
    "engagement_signals": {
      "partitions": 20,
      "replication_factor": 3,
      "retention_days": 1,
      "compression": "snappy",
      "consumers": [
        "real_time_dashboard",
        "anomaly_detection",
        "engagement_scorer"
      ],
      "priority": "high",
      "schema": {
        "member_id": "uuid",
        "signal_type": "string",
        "intensity": "float",
        "timestamp": "timestamp_with_timezone"
      }
    },
    "ml_predictions": {
      "partitions": 5,
      "replication_factor": 2,
      "retention_days": 30,
      "consumers": [
        "marketing_automation",
        "ui_personalization",
        "campaign_engine"
      ],
      "schema": {
        "member_id": "uuid",
        "model_name": "string",
        "prediction_type": "string",
        "score": "float",
        "confidence": "float",
        "generated_at": "timestamp_with_timezone"
      }
    }
  },
  "flinkJobs": {
    "jobs": [
      {
        "name": "active_members_aggregator",
        "source": "member_events",
        "window": "tumbling_60s",
        "aggregation": {
          "metric": "active_members_current",
          "function": "distinct_count(member_id)",
          "output_interval": 60
        },
        "sink": "redis_cache",
        "latency_sla_ms": 5000
      },
      {
        "name": "engagement_momentum_calculator",
        "source": "engagement_signals",
        "window": "sliding_3600s",
        "aggregation": {
          "metric": "engagement_momentum_1h",
          "function": "sum(intensity) / count(*)",
          "output_interval": 60
        },
        "sink": "timeseries_db",
        "latency_sla_ms": 3000
      },
      {
        "name": "churn_risk_distribution",
        "source": "ml_predictions",
        "filter": "model_name = 'churn_7d'",
        "window": "tumbling_300s",
        "aggregation": {
          "metric": "churn_risk_distribution",
          "buckets": [
            {"range": "0-20%", "count": "count(*)"},
            {"range": "20-40%", "count": "count(*)"},
            {"range": "40-60%", "count": "count(*)"},
            {"range": "60-80%", "count": "count(*)"},
            {"range": "80-100%", "count": "count(*)"}
          ],
          "output_interval": 300
        },
        "sink": "analytics_dashboard",
        "latency_sla_ms": 10000
      },
      {
        "name": "feature_adoption_velocity",
        "source": "member_events",
        "filter": "event_type = 'feature_adopted'",
        "window": "tumbling_3600s",
        "enrichment": "join with feature_catalog",
        "aggregation": {
          "metric": "feature_adoption_velocity",
          "function": "count(*) / 3600",
          "group_by": "feature_id",
          "output_interval": 3600
        },
        "sink": "analytics_engine",
        "latency_sla_ms": 30000
      },
      {
        "name": "anomaly_detector",
        "source": "member_events",
        "window": "sliding_300s",
        "algorithm": "isolation_forest",
        "features": [
          "event_frequency",
          "event_type_diversity",
          "session_duration",
          "api_call_rate"
        ],
        "alerting": {
          "threshold": 0.85,
          "channels": ["slack", "dashboard"]
        },
        "latency_sla_ms": 10000
      }
    ]
  },
  "realtimeDashboards": {
    "dashboards": [
      {
        "name": "operations_overview",
        "url": "/monitoring-dashboard.html#realtime",
        "refresh_interval_ms": 5000,
        "metrics": [
          "active_members_current",
          "events_per_second",
          "avg_event_latency",
          "kafka_lag"
        ]
      },
      {
        "name": "engagement_heatmap",
        "url": "/analytics-dashboard.html#engagement-realtime",
        "refresh_interval_ms": 10000,
        "metrics": [
          "engagement_momentum_1h",
          "feature_adoption_velocity",
          "session_distribution_by_hour"
        ]
      },
      {
        "name": "churn_risk_live",
        "url": "/segmentation-dashboard.html#churn-live",
        "refresh_interval_ms": 30000,
        "metrics": [
          "high_risk_members_count",
          "churn_risk_distribution",
          "at_risk_alerts_generated"
        ]
      }
    ]
  },
  "eventSchema": {
    "member_events": {
      "page_view": {
        "properties": {
          "page_url": "string",
          "referrer": "string",
          "device_type": "string",
          "user_agent": "string"
        }
      },
      "feature_adopted": {
        "properties": {
          "feature_id": "string",
          "time_to_adoption_seconds": "integer",
          "discovery_method": "enum(search, recommendation, tutorial, community)"
        }
      },
      "api_call": {
        "properties": {
          "endpoint": "string",
          "method": "enum(GET, POST, PUT, DELETE)",
          "status_code": "integer",
          "latency_ms": "integer",
          "quota_used_percent": "float"
        }
      },
      "support_ticket": {
        "properties": {
          "category": "string",
          "priority": "enum(low, medium, high, critical)",
          "time_to_resolution_minutes": "integer",
          "satisfaction_rating": "float"
        }
      },
      "engagement_signal": {
        "properties": {
          "signal_type": "enum(scroll, click, input, hover, focus)",
          "element_type": "string",
          "time_spent_ms": "integer"
        }
      }
    }
  },
  "dataQuality": {
    "validation_rules": [
      {
        "name": "event_completeness",
        "check": "all required fields present",
        "threshold_percent": 99.5,
        "alert_on_breach": true
      },
      {
        "name": "timestamp_validity",
        "check": "timestamp within 5 minutes of server time",
        "threshold_percent": 99.9,
        "alert_on_breach": true
      },
      {
        "name": "member_id_validation",
        "check": "member_id matches active member UUID",
        "threshold_percent": 99.8,
        "alert_on_breach": true
      },
      {
        "name": "duplicate_detection",
        "check": "no duplicate events within 5 second window",
        "threshold_percent": 99.9,
        "alert_on_breach": true
      }
    ]
  },
  "performanceTargets": {
    "latency": {
      "p50": 50,
      "p95": 200,
      "p99": 1000,
      "unit": "milliseconds"
    },
    "throughput": {
      "target_events_per_second": 10000,
      "peak_capacity_events_per_second": 50000,
      "burst_handling": "automatic_scaling"
    },
    "availability": {
      "target_uptime": "99.99%",
      "rpo": 60,
      "rto": 300,
      "unit": "seconds"
    }
  },
  "integration": {
    "sources": [
      {
        "name": "web_sdk",
        "type": "javascript_client",
        "event_types": [
          "page_view",
          "feature_adopted",
          "engagement_signal"
        ]
      },
      {
        "name": "api_server",
        "type": "backend_server",
        "event_types": [
          "api_call",
          "support_ticket",
          "billing_event"
        ]
      },
      {
        "name": "ml_pipeline",
        "type": "prediction_service",
        "event_types": [
          "churn_prediction",
          "propensity_score",
          "ltv_forecast"
        ]
      }
    ],
    "sinks": [
      {
        "name": "redis_cache",
        "use_case": "real_time_dashboard_cache",
        "ttl_seconds": 300
      },
      {
        "name": "timeseries_db",
        "use_case": "historical_metrics",
        "retention_days": 365
      },
      {
        "name": "analytics_engine",
        "use_case": "downstream_processing",
        "batch_interval_seconds": 300
      }
    ]
  }
}
