# Secret NAMES the Edge Functions read. Values here are deliberately invalid.
#
# Never put a real value in this file or anywhere tracked. Real values live only
# in Supabase secrets:  supabase secrets set NAME=value   (CLAUDE.md 9)
# A local `supabase/functions/.env` for `supabase functions serve` is gitignored.
#
# Not listed: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEY(S), SB_EXECUTION_ID -- the
# platform injects those into every function.
#
# scripts/tests/test_env_example.py keeps this list equal to the names the
# functions read, and fails on any value that is not an obvious placeholder.

# concierge, concierge-/growth-/product-orchestrator, graphify-ai-* (Anthropic API)
ANTHROPIC_API_KEY=replace-me
# checkout (all four), stripe-webhook (secret key + webhook secret) -- payments
# stay dormant until the owner sets these
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_MAP=replace-me
SITE_URL=replace-me
# notify-access, weekly-digest (Resend email)
RESEND_API_KEY=replace-me
NOTIFY_ACCESS_WEBHOOK_SECRET=replace-me
# market-price
TWELVE_DATA_API_KEY=replace-me
# provider + embedding workers (worker secret), embedding worker (gateway),
# omega-media-worker (media provider)
OMEGA_PROVIDER_WORKER_SECRET=replace-me
OMEGA_EMBEDDING_GATEWAY_URL=replace-me
OMEGA_EMBEDDING_GATEWAY_SECRET=replace-me
OMEGA_MEDIA_PROVIDER_URL=replace-me
OMEGA_MEDIA_PROVIDER_SECRET=replace-me
