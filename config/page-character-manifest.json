    "finance": {
      "visual": "treasury",
      "motion": "precise",
      "depth": "glass",
      "density": "data",
      "interaction": "manage",
      "emblem": "treasury",
      "worldRole": "Treasurer",
      "worldVerb": "MANAGE",
      "primaryActions": [
        "track",
        "budget",
        "pay",
        "invest"
      ],
