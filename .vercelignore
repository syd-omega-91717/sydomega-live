# SYD OMEGA 91717 -- backend exclusion for the public static deployment.
# The build emits the web surface into public/ and Vercel publishes only that
# directory. Keep private source, infrastructure, and project instructions out
# of the deployment input.

# Supabase backend -- SQL migrations, policies, and server functions.
supabase/

# Backend/source-only extensions.
*.ts
*.tsx
*.py
*.sol
*.sql

# Private documentation and local-only files.
*.md
*.doc
*.docx
*.pdf
.env
.env.*
*.log

# Tooling and repository metadata.
node_modules/
.git/
.github/
.claude/
.vscode/
.idea/
.mailmap
package.json
package-lock.json
