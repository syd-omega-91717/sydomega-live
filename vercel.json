{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "",
  "outputDirectory": "public",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": false
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/investor-dashboard",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/investor-gate",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/venture-pipeline",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/omega-visual-command",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/agent",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/cohorts-dashboard",
      "destination": "/control-center",
      "permanent": true
    },
    {
      "source": "/entreprise",
      "destination": "/enterprise",
      "permanent": true
    },
    {
      "source": "/entreprise.html",
      "destination": "/enterprise.html",
      "permanent": true
    },
    {
      "source": "/sovereign",
      "destination": "/sovereign-ai",
      "permanent": true
    },
    {
      "source": "/sovereign.html",
      "destination": "/sovereign-ai.html",
      "permanent": true
    },
    {
      "source": "/omega-visual-home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/omega-visual-home.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/omega-release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|css|json|png|jpg|jpeg|webp|gif|svg|ico|woff2|mp4|webm|glb)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), accelerometer=(self), gyroscope=(self), magnetometer=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(admin|owner|private|api)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
