{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo skip-install",
  "buildCommand": "echo static-no-build",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/:path*.ts", "destination": "/index.html", "permanent": false },
    { "source": "/:path*.py", "destination": "/index.html", "permanent": false },
    { "source": "/:path*.sol", "destination": "/index.html", "permanent": false },
    { "source": "/:path*.sql", "destination": "/index.html", "permanent": false },
    { "source": "/:path*.docx", "destination": "/index.html", "permanent": false }
  ]
}
