{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Ω Governed Content Task Pipeline",
  "version": 1,
  "status": "IMPLEMENTED_PROVIDER_DEPLOYED",
  "principle": "UPLOAD_IS_NOT_PUBLICATION",
  "source_of_truth": [
    "Supabase Storage bucket uploads",
    "public.storage_files",
    "public.storage_shares",
    "public.omega_platform_events"
  ],
  "upload": {
    "states": [
      "SELECTED",
      "VALIDATED",
      "AUTHORIZED",
      "UPLOADED",
      "REGISTERED",
      "PENDING_REVIEW",
      "FAILED",
      "ROLLED_BACK"
    ],
    "required": {
      "authentication": true,
      "owner_path": true,
      "storage_record": true,
      "audit_event": true
    },
    "rules": [
      "client_upload_must_be_authenticated",
      "storage_path_first_segment_must_equal_authenticated_user_id",
      "server_registration_is_required_after_storage_upload",
      "registration_failure_must_attempt_storage_rollback",
      "registration_does_not_prove_rights",
      "registration_does_not_prove_publication",
      "registration_does_not_prove_entitlement",
      "registration_does_not_prove_malware_scan"
    ],
    "bucket_enforcement": {
      "bucket": "uploads",
      "private": true,
      "file_size_limit_bytes": 52428800,
      "file_size_limit_mib": 50,
      "allowed_mime_types": null,
      "source_migration": "20261117004605_uploads_bucket_size_limit_50mb",
      "verified_at": "2026-11-17",
      "purpose": "Server-side size ceiling matching the existing upload.js client cap; MIME allowlist remains open for arbitrary binary attachments."
    },
    "validation": {
      "content_signature": "PROVIDER_DEPLOYED_ENTRYPOINT_VERIFIED",
      "sha256": "PROVIDER_DEPLOYED_ENTRYPOINT_VERIFIED",
      "malware_scan": "UNAVAILABLE",
      "rights_review": "REQUIRED_BEFORE_PUBLICATION",
      "note": "content-ingest downloads the private object, enforces the 50 MiB limit, identifies common byte signatures and records SHA-256. The provider is active at version 11 and its entrypoint matches repository source. Signature identification is not malware scanning or rights clearance; no production Storage object currently exists to exercise a member upload transaction."
    }
  },
  "download": {
    "states": [
      "REQUESTED",
      "AUTHENTICATED",
      "AUTHORIZED",
      "DELIVERED",
      "DENIED",
      "FAILED",
      "SIGNED_ATTACHMENT"
    ],
    "required": {
      "authentication": true,
      "owner_authorization": true,
      "signed_url": true,
      "audit_event": true
    },
    "rules": [
      "first_slice_is_owner_only",
      "shared_delivery_is_not_inferred_from_storage_shares_until_explicit_policy_is_verified",
      "public_download_is_never_inferred_from_storage_path",
      "signed_url_is_time_limited",
      "private_user_upload_delivery_must_force_content_disposition_attachment"
    ],
    "delivery_mode": "SIGNED_ATTACHMENT",
    "signed_url_ttl_seconds": 900
  },
  "truth_states": {
    "registered": "LIVE",
    "rights": "UNVERIFIED",
    "publication": "UNVERIFIED",
    "entitlement": "UNVERIFIED",
    "scan": "UNAVAILABLE_UNLESS_PROVIDER_EVIDENCE_EXISTS",
    "signature": "IDENTIFIED_NOT_MALWARE_CLEARED"
  },
  "release_rule": "Provider deployment evidence is recorded, but authenticated end-to-end transaction evidence, rights/publication/entitlement and malware-scan evidence remain separate truth gates.",
  "provider_evidence": {
    "source": "docs/runtime/supabase-edge-functions-live.json",
    "functions": {
      "content-ingest": {
        "status": "DEPLOYED",
        "live_version": 11,
        "verify_jwt": true,
        "source": "supabase/functions/content-ingest/index.ts",
        "dependencies": [
          "supabase/functions/_shared/content-validation.mjs"
        ],
        "source_parity": "EXACT_ENTRYPOINT_MATCH",
        "provider_observed_at": "2026-11-17T07:48:00.000Z"
      },
      "content-delivery": {
        "status": "DEPLOYED",
        "live_version": 11,
        "verify_jwt": true,
        "source": "supabase/functions/content-delivery/index.ts",
        "dependencies": [],
        "source_parity": "EXACT_ENTRYPOINT_MATCH",
        "provider_observed_at": "2026-11-17T07:48:00.000Z"
      }
    },
    "limitation": "Both content functions are ACTIVE at provider version 11 and their deployed entrypoints match repository source byte-for-byte. The isolated Supabase CI stack passes authenticated upload/download, owner isolation, path guard, idempotency, expiry and audit probes. Production currently has zero Storage objects and zero storage_files rows, so no production user upload/download transaction has yet been observed. Malware scanning, rights review, publication approval and entitlements remain separate fail-closed gates."
  }
}
