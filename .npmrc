engine-strict=false
legacy-peer-deps=true
workspaces-update-check=false
# Wait 7 days before installing a newly published version (supply-chain
# hardening). npm 10, which CI runs today, does not know this key and ignores it
# with a warning; it takes effect once npm supports it. CI already installs only
# exact, weeks-old versions with --ignore-scripts.
min-release-age=7
